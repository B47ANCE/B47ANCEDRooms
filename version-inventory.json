{
  "schema": 1,
  "canonical": "VERSION",
  "mirrors": [
    {
      "path": "docs/OUTLINE_ZOOM_FIX.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/WORKSHOP_DESCRIPTION.md",
      "pattern": "^Version (?P<version>\\S+)\\.$"
    },
    {
      "path": "docs/WORKSHOP_CHANGELOG.md",
      "pattern": "^# Version (?P<version>\\S+)$"
    },
    {
      "path": "docs/CLEANING_API.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "README.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "src/B47ANCEDRooms/42/mod.info",
      "pattern": "^modversion=(?P<version>\\S+)$"
    },
    {
      "path": "docs/ROOMS_API.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "src/B47ANCEDRooms/42/media/lua/shared/B47ANCEDRooms/Identity.lua",
      "pattern": "version='(?P<version>[0-9][^']*)'"
    }
  ],
  "changelog": {
    "path": "CHANGELOG.md",
    "pattern": "^## \\[(?P<version>[^\\]]+)\\]$"
  },
  "packaging": {
    "artifacts": [
      {
        "glob": "dist/current/*.zip",
        "pattern": "B47ANCEDRooms-(?P<version>.+)\\.zip",
        "zip_members": [
          {
            "member": "B47ANCEDRooms/42/mod.info",
            "pattern": "^modversion=(?P<version>[^\\r\\n]+)\\r?$"
          }
        ]
      }
    ]
  },
  "other_versions": [
    {
      "category": "pz",
      "reference": "src/B47ANCEDRooms/42/mod.info: versionMin",
      "reason": "Native game compatibility, independent of project SemVer"
    }
  ],
  "historical": [
    {
      "reference": "docs/WORKSHOP_PUBLICATION.md",
      "reason": "Immutable 0.1.0-dev.1 publication/distribution evidence, not proof of current source or runtime correctness."
    },
    {
      "reference": "dist/current/B47ANCEDRooms-0.1.0-dev.1.zip and adjacent provenance/hash records",
      "reason": "Preserved prior published artifacts; no cleanup or packaging requested. The unchanged artifact glob continues to flag these as stale for current release checks."
    }
  ]
}
