{
  "schema": 1,
  "canonical": "VERSION",
  "mirrors": [
    {
      "path": "docs/WORKSHOP_UI_PUBLICATION.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/UI_AUDIT.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "docs/WORKSHOP_DESCRIPTION.md",
      "pattern": "^Version (?P<version>\\S+)\\.$"
    },
    {
      "path": "docs/WORKSHOP_CHANGELOG.md",
      "pattern": "^# Version (?P<version>\\S+)$"
    },
    {
      "path": "docs/CLEANING_API.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "README.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "src/B47ANCEDRooms/42/mod.info",
      "pattern": "^modversion=(?P<version>\\S+)$"
    },
    {
      "path": "docs/ROOMS_API.md",
      "pattern": "^Project Version: (?P<version>\\S+)$"
    },
    {
      "path": "src/B47ANCEDRooms/42/media/lua/shared/B47ANCEDRooms/Identity.lua",
      "pattern": "version='(?P<version>[0-9][^']*)'"
    }
  ],
  "changelog": {
    "path": "CHANGELOG.md",
    "pattern": "^## \\[(?P<version>[^\\]]+)\\]$"
  },
  "packaging": {
    "artifacts": [
      {
        "glob": "dist/current/*.zip",
        "pattern": "B47ANCEDRooms-(?P<version>.+)\\.zip",
        "zip_members": [
          {
            "member": "B47ANCEDRooms/42/mod.info",
            "pattern": "^modversion=(?P<version>[^\\r\\n]+)\\r?$"
          }
        ]
      }
    ]
  },
  "other_versions": [
    {
      "category": "pz",
      "reference": "src/B47ANCEDRooms/42/mod.info: versionMin",
      "reason": "Native game compatibility, independent of project SemVer"
    }
  ],
  "historical": [
    {
      "reference": "docs/WORKSHOP_PUBLICATION.md",
      "reason": "Immutable 0.1.0-dev.1 publication/distribution evidence, not proof of current source or runtime correctness."
    },
    {
      "reference": "dist/workshop-publish/0.1.0-dev.2-outline/previous-current and preservation-ledger.json",
      "reason": "Prior 0.1.0-dev.1 published artifacts preserved with exact hashes during explicitly authorized test-upload preparation. No historical package was relabeled or deleted."
    },
    {
      "reference": "docs/WORKSHOP_OUTLINE_PUBLICATION.md and docs/OUTLINE_ZOOM_FIX.md",
      "reason": "Evidence tied to published 0.1.0-dev.2 and its source-fix checkpoint; not current popup validation."
    },
    {
      "reference": "dist/workshop-publish/0.1.0-dev.3-ui/previous-current and preservation-ledger.json",
      "reason": "Published 0.1.0-dev.2 ZIP/provenance preserved with exact hashes during authorized .3 test-upload preparation. No historical package was relabeled or deleted."
    }
  ]
}
